	fragment@45 {
		target = <0xffffffff>;

		__overlay__ {

			nfc {

				nfc_int_active {
					phandle = <0x62>;

					mux {
						pins = "gpio75";
						function = "gpio";
					};

					config {
						pins = "gpio75";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				nfc_int_suspend {
					phandle = <0x64>;

					mux {
						pins = "gpio75";
						function = "gpio";
					};

					config {
						pins = "gpio75";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				nfc_enable_active {
					phandle = <0x63>;

					mux {
						pins = "gpio34\0gpio35";
						function = "gpio";
					};

					config {
						pins = "gpio34\0gpio35";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				nfc_enable_suspend {
					phandle = <0x65>;

					mux {
						pins = "gpio34\0gpio35";
						function = "gpio";
					};

					config {
						pins = "gpio34\0gpio35";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
		};
	};

	fragment@46 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0xf4240>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nq@28 {
				compatible = "qcom,sn-nci";
				reg = <0x28>;
				qcom,sn-irq = <0xffffffff 0x4b 0x00>;
				qcom,sn-ven = <0xffffffff 0x22 0x00>;
				qcom,sn-clkreq = <0xffffffff 0x23 0x00>;
				qcom,sn-vdd-1p8-supply = <0xffffffff>;
				qcom,sn-vdd-1p8-voltage = <0x124f80 0x124f80>;
				qcom,sn-vdd-1p8-current = <0x26548>;
				qcom,sn-szone = "enable";
				interrupt-parent = <0xffffffff>;
				nvmem-cells = <0x61>;
				nvmem-cell-names = "nfc_bob1_cell";
				interrupts = <0x4b 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "nfc_active\0nfc_suspend";
				pinctrl-0 = <0x62 0x63>;
				pinctrl-1 = <0x64 0x65>;
			};
		};
	};

