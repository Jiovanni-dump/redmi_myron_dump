	fragment@236 {
		phandle = <0x371>;
		target = <0xffffffff>;

		__overlay__ {

			bt_swr_clk_data_pinctrl {
				phandle = <0x2cf>;
				#gpio-cells = <0x00>;
				qcom,lpi-gpios;
				pinctrl-1 = <0x2cb 0x2cc>;
				pinctrl-0 = <0x2c9 0x2ca>;
				pinctrl-names = "aud_active\0aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
			};
		};
	};

	fragment@238 {
		phandle = <0x372>;
		target = <0xffffffff>;

		__overlay__ {
			qcom,bt-swr-gpios = <0x2cf>;
			clocks = <0x2cd 0x00 0x2ce 0x00 0xffffffff 0x00 0xffffffff 0x00>;
			clock-names = "bt_swr_mclk_clk\0bt_swr_mclk_clk_2x\0lpass_core_hw_vote\0lpass_audio_hw_vote";
			compatible = "qcom,lpass-bt-swr";
		};
	};

	fragment@240 {
		phandle = <0x373>;
		target = <0xffffffff>;

		__overlay__ {
			qcom,swr-num-dev = <0x01>;
			qcom,swr-port-mapping = <0x01 0x65 0x03 0x02 0x67 0x03 0x03 0x69 0x03 0x05 0x66 0x03 0x06 0x68 0x03 0x07 0x6a 0x03 0x08 0x6b 0x03>;
			qcom,swr-num-ports = <0x07>;
			interrupt-names = "swr_master_irq";
			clocks = <0xffffffff 0x00 0xffffffff 0x00>;
			clock-names = "lpass_core_hw_vote\0lpass_audio_hw_vote";
			qcom,swr_master_id = <0x05>;
			compatible = "qcom,swr-mstr";
		};
	};

